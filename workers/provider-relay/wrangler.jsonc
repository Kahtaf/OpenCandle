{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "opencandle-provider-relay",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-31",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "https://web.opencandle.app/v1/provider-fetch",
      "zone_name": "opencandle.app"
    },
    {
      "pattern": "https://web.opencandle.app/v1/model-fetch",
      "zone_name": "opencandle.app"
    },
    {
      "pattern": "https://web.opencandle.app/v1/health",
      "zone_name": "opencandle.app"
    },
    {
      "pattern": "https://web.opencandle.app/v1/runtime-token",
      "zone_name": "opencandle.app"
    }
  ],
  "ratelimits": [
    {
      "name": "PROVIDER_RELAY_RATE_LIMITER",
      "namespace_id": "13001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false,
    "logs": {
      "invocation_logs": false
    }
  }
}
