# Optional - model providers used by Pi / GUI setup.
# Uncomment one or more real keys. Placeholder values will be treated as keys.
# GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional - financial data providers.
# Environment variables override $OPENCANDLE_HOME/config.json.
# ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
# FRED_API_KEY=your-fred-api-key
# BRAVE_API_KEY=your-brave-key
# EXA_API_KEY=your-exa-key
# FINNHUB_API_KEY=your-finnhub-key

# Optional - OpenCandle runtime config
# OPENCANDLE_HOME=~/.opencandle
# OPENCANDLE_DEBATE=true
# OPENCANDLE_ROUTER_MODE=llm
# OPENCANDLE_GUI_HOST=127.0.0.1
# OPENCANDLE_GUI_PORT=14567

# No API key needed: Yahoo Finance, CoinGecko, alternative.me crypto Fear & Greed, Reddit
