# Optional - financial data providers.
# Environment variables override $OPENCANDLE_HOME/config.json.
# ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
# FRED_API_KEY=your-fred-api-key
# BRAVE_API_KEY=your-brave-key
# EXA_API_KEY=your-exa-key
# FINNHUB_API_KEY=your-finnhub-key
# LSE_API_KEY=your-london-strategic-edge-key

# Optional - OpenCandle runtime config
# OPENCANDLE_ROUTER_MODE=llm
# OPENCANDLE_TOOL_SCOPE_MODE=observe

# No API key needed: Yahoo Finance, TradingView scanner, Polymarket Gamma,
# CoinGecko, alternative.me crypto Fear & Greed, SEC EDGAR, DuckDuckGo search.
# Reddit sentiment additionally needs rdt-cli and an active Reddit browser session.
