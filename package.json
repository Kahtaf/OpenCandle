{
  "name": "opencandle",
  "version": "0.15.0",
  "description": "Open source financial investigator: evidence-first market research agent for your terminal and local GUI",
  "license": "MIT",
  "homepage": "https://opencandle.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kahtaf/OpenCandle.git"
  },
  "bugs": {
    "url": "https://github.com/Kahtaf/OpenCandle/issues"
  },
  "type": "module",
  "workspaces": [
    "gui/hosted",
    "gui/server",
    "gui/web",
    "packages/ui",
    "website",
    "workers/provider-relay"
  ],
  "bin": {
    "opencandle": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tool-kit": {
      "types": "./dist/tool-kit.d.ts",
      "import": "./dist/tool-kit.js"
    },
    "./infra": {
      "types": "./dist/infra/index.d.ts",
      "import": "./dist/infra/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    },
    "./workflows": {
      "types": "./dist/workflows/index.d.ts",
      "import": "./dist/workflows/index.js"
    }
  },
  "pi": {
    "extensions": [
      "./dist/pi/opencandle-extension.js"
    ]
  },
  "keywords": [
    "opencandle",
    "finance",
    "stock",
    "investing",
    "options",
    "market-data",
    "portfolio",
    "ai-agent",
    "terminal",
    "financial-analysis",
    "sentiment",
    "technical-analysis",
    "pi-package"
  ],
  "files": [
    "assets/logo.svg",
    "dist",
    "gui/web/dist"
  ],
  "scripts": {
    "check:node": "node scripts/check-node-version.mjs",
    "prebuild": "npm run check:node && node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc && node scripts/build-gui-server.mjs && node scripts/make-cli-executable.mjs",
    "prepare": "npm run build && npm run gui:web:build",
    "prestart": "npm run check:node",
    "start": "tsx src/cli.ts",
    "gui:web:build": "npm --workspace @opencandle/gui-web run build",
    "gui:hosted:build": "npm --workspace @opencandle/gui-hosted run build",
    "gui:hosted:dev": "npm --workspace @opencandle/gui-hosted run dev",
    "generate:pi-model-catalog": "tsx scripts/generate-pi-model-catalog.ts && biome format --write src/pi/model-catalog.generated.ts",
    "relay:dev": "npm --workspace @opencandle/provider-relay run dev",
    "relay:test": "npm --workspace @opencandle/provider-relay test",
    "relay:typecheck": "npm --workspace @opencandle/provider-relay run typecheck",
    "relay:types": "npm --workspace @opencandle/provider-relay run types",
    "relay:smoke:browser": "tsx workers/provider-relay/scripts/browser-live-smoke.ts",
    "docs:site:build": "npm --workspace @opencandle/website run build",
    "docs:site:serve": "node website/serve.mjs",
    "test:site": "npm run docs:site:build && vitest run --project site",
    "docs:links:check": "node scripts/check-public-doc-links.mjs",
    "gui": "tsx gui/server/server.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test:scripts:typecheck && npm run relay:typecheck && biome ci .",
    "gates": "node scripts/test-gate.mjs core",
    "gates:full": "node scripts/test-gate.mjs full",
    "bootstrap:agent": "node scripts/agent-bootstrap.mjs",
    "pretest": "npm run check:node",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:agent-tools": "vitest run --project agent-tools",
    "test:scripts:typecheck": "tsc -p tsconfig.test-scripts.json",
    "test:e2e": "tsx tests/e2e/tools.test.ts",
    "test:e2e:cli": "tsx tests/e2e/cli.test.ts",
    "test:e2e:credential": "tsx tests/e2e/credential-prompt.test.ts && tsx tests/e2e/credential-snooze.test.ts && tsx tests/e2e/credential-soft-fallback.test.ts && tsx tests/e2e/credential-per-workflow-cap.test.ts",
    "test:gui:browser": "OPENCANDLE_GUI_BROWSER=1 vitest run --project gui-browser",
    "test:gui:journey": "npm run gui:web:build && vitest run --project gui-journey",
    "test:gui:hosted": "npm --workspace @opencandle/gui-hosted run test:browser",
    "test:gui:release-smoke": "npm run gui:web:build && OPENCANDLE_GUI_RELEASE_SMOKE=1 vitest run --project gui-release",
    "test:e2e:providers": "tsx tests/e2e/providers.test.ts",
    "test:e2e:harness-dcf": "tsx tests/e2e/harness-dcf.test.ts",
    "eval": "tsx tests/scripts/run-evals.ts",
    "test:packed-install": "node scripts/packed-install-smoke.mjs",
    "review:pr": ".agents/skills/autoreview/scripts/autoreview --mode branch --prompt-file .agents/skills/autoreview/references/opencandle-review.md --parallel-tests \"npm run gates:full\"",
    "package:contents:check": "node scripts/check-package-contents.mjs",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "prepublishOnly": "npm run release:check",
    "publish:dry": "npm run release:check && npm publish --access public --dry-run",
    "release:check": "node scripts/test-gate.mjs release",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "test:coverage": "npm run coverage:node && npm run coverage:check && npm run coverage:browser",
    "coverage:baseline": "node scripts/coverage-report.mjs --update-baseline",
    "test:inventory": "node scripts/test-inventory.mjs",
    "test:providers:release": "tsx tests/e2e/provider-release-smoke.ts",
    "test:gui:integration": "npm run gui:web:build && OPENCANDLE_GUI_INTEGRATION=1 vitest run --project gui-integration",
    "test:coverage:browser": "npm run coverage:node && npm run coverage:browser",
    "coverage:node": "vitest run --project unit --coverage && npm --workspace @opencandle/provider-relay run test -- --coverage && node scripts/coverage-merge.mjs --out coverage",
    "coverage:check": "node scripts/coverage-report.mjs --input coverage/coverage-summary.json --baseline scripts/coverage-baseline.json --check",
    "coverage:browser": "node -e \"for (const d of ['coverage/browser', 'coverage/merged']) require('node:fs').rmSync(d, { recursive: true, force: true })\" && npm run gui:web:build -- -- --sourcemap && OPENCANDLE_BROWSER_COVERAGE=1 OPENCANDLE_GUI_INTEGRATION=1 vitest run --project gui-integration --project gui-journey && node scripts/coverage-browser.mjs && node scripts/coverage-merge.mjs --out coverage/merged --browser coverage/browser/coverage-final.json && node scripts/coverage-report.mjs --input coverage/merged/coverage-summary.json --informational --metadata coverage/browser/metadata.json"
  },
  "engines": {
    "node": "^22.22.2 || >=24.0.0 <27"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.86.1",
    "@earendil-works/pi-ai": "^0.86.1",
    "@earendil-works/pi-coding-agent": "0.86.1",
    "better-sqlite3": "^13.0.3",
    "ddg-kit": "0.1.1",
    "sql.js": "^1.14.2",
    "yahoo-finance2": "^4.0.2"
  },
  "peerDependencies": {
    "@sinclair/typebox": "*"
  },
  "overrides": {
    "@hono/node-server": "^2.0.12",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@sinclair/typebox": "^0.34.52",
    "@tanstack/react-router": "^1.170.38",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/semver": "^7.8.0",
    "@types/sql.js": "^1.4.11",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.1.0",
    "lightweight-charts": "^5.2.1",
    "playwright-core": "^1.63.0",
    "semver": "^7.8.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "@vitest/istanbul-lib-coverage": "^1.0.1",
    "@vitest/istanbul-lib-report": "^1.0.1",
    "ast-v8-to-istanbul": "^1.0.7"
  }
}
