{
  "name": "opencandle",
  "version": "0.13.0",
  "description": "Open source financial investigator: evidence-first market research agent for your terminal and local GUI",
  "license": "MIT",
  "homepage": "https://opencandle.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kahtaf/OpenCandle.git"
  },
  "bugs": {
    "url": "https://github.com/Kahtaf/OpenCandle/issues"
  },
  "type": "module",
  "workspaces": [
    "gui/hosted",
    "gui/server",
    "gui/web",
    "packages/ui",
    "website",
    "workers/provider-relay"
  ],
  "bin": {
    "opencandle": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tool-kit": {
      "types": "./dist/tool-kit.d.ts",
      "import": "./dist/tool-kit.js"
    },
    "./infra": {
      "types": "./dist/infra/index.d.ts",
      "import": "./dist/infra/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    },
    "./workflows": {
      "types": "./dist/workflows/index.d.ts",
      "import": "./dist/workflows/index.js"
    }
  },
  "pi": {
    "extensions": [
      "./dist/pi/opencandle-extension.js"
    ]
  },
  "keywords": [
    "opencandle",
    "finance",
    "stock",
    "investing",
    "options",
    "market-data",
    "portfolio",
    "ai-agent",
    "terminal",
    "financial-analysis",
    "sentiment",
    "technical-analysis",
    "pi-package"
  ],
  "files": [
    "assets/logo.svg",
    "dist",
    "gui/web/dist"
  ],
  "scripts": {
    "check:node": "node scripts/check-node-version.mjs",
    "prebuild": "npm run check:node && node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc && node scripts/build-gui-server.mjs && node scripts/make-cli-executable.mjs",
    "prepare": "npm run build && npm run gui:web:build",
    "prestart": "npm run check:node",
    "start": "tsx src/cli.ts",
    "gui:web:build": "npm --workspace @opencandle/gui-web run build",
    "gui:hosted:build": "npm --workspace @opencandle/gui-hosted run build",
    "gui:hosted:dev": "npm --workspace @opencandle/gui-hosted run dev",
    "generate:pi-model-catalog": "tsx scripts/generate-pi-model-catalog.ts && biome format --write src/pi/model-catalog.generated.ts",
    "relay:dev": "npm --workspace @opencandle/provider-relay run dev",
    "relay:test": "npm --workspace @opencandle/provider-relay test",
    "relay:typecheck": "npm --workspace @opencandle/provider-relay run typecheck",
    "relay:types": "npm --workspace @opencandle/provider-relay run types",
    "relay:smoke:live": "tsx workers/provider-relay/scripts/live-smoke.ts",
    "relay:smoke:browser": "tsx workers/provider-relay/scripts/browser-live-smoke.ts",
    "docs:site:build": "npm --workspace @opencandle/website run build",
    "docs:site:serve": "node website/serve.mjs",
    "docs:links:check": "node scripts/check-public-doc-links.mjs",
    "gui": "tsx gui/server/server.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "gates": "npm run typecheck && npm run relay:typecheck && npx biome ci . && npm run gui:hosted:build && npm test && npm run relay:test && npm run test:agent-tools",
    "bootstrap:agent": "node scripts/agent-bootstrap.mjs",
    "pretest": "npm run check:node",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:agent-tools": "vitest run --config vitest.config.agent-tools.ts",
    "test:scripts:typecheck": "tsc -p tsconfig.test-scripts.json",
    "test:e2e": "tsx tests/e2e/tools.test.ts",
    "test:e2e:cli": "tsx tests/e2e/cli.test.ts",
    "test:e2e:credential-prompt": "tsx tests/e2e/credential-prompt.test.ts",
    "test:e2e:credential-snooze": "tsx tests/e2e/credential-snooze.test.ts",
    "test:e2e:credential-soft-fallback": "tsx tests/e2e/credential-soft-fallback.test.ts",
    "test:e2e:credential-per-workflow-cap": "tsx tests/e2e/credential-per-workflow-cap.test.ts",
    "test:gui:browser": "OPENCANDLE_GUI_BROWSER=1 vitest run --config vitest.config.gui.ts",
    "test:gui:hosted": "npm --workspace @opencandle/gui-hosted run test:browser",
    "test:hosted:tui-continuation": "tsx tests/harness/hosted-tui-continuation.ts",
    "test:gui:release-smoke": "npm run gui:web:build && OPENCANDLE_GUI_RELEASE_SMOKE=1 vitest run --config vitest.config.gui-release.ts",
    "test:e2e:providers": "tsx tests/e2e/providers.test.ts",
    "test:e2e:harness-dcf": "tsx tests/e2e/harness-dcf.test.ts",
    "eval": "tsx tests/scripts/run-evals.ts",
    "test:packed-install": "node scripts/packed-install-smoke.mjs",
    "review:pr": ".agents/skills/autoreview/scripts/autoreview --mode branch --prompt-file .agents/skills/autoreview/references/opencandle-review.md --parallel-tests \"npm run gates\"",
    "package:contents:check": "node scripts/check-package-contents.mjs",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "prepublishOnly": "npm run release:check",
    "publish:dry": "npm run release:check && npm publish --access public --dry-run",
    "release:check": "npx tsc --noEmit && npm run test:scripts:typecheck && npx biome ci . && npm test && npm run test:gui:release-smoke && npm run docs:site:build && npm run package:contents:check && npm run test:packed-install && npm run docs:links:check",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "engines": {
    "node": "^22.22.2 || >=24.0.0 <27"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.83.0",
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "better-sqlite3": "^13.0.1",
    "ddg-kit": "0.1.0",
    "yahoo-finance2": "^4.0.0"
  },
  "peerDependencies": {
    "@sinclair/typebox": "*"
  },
  "overrides": {
    "@hono/node-server": "^2.0.12",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.64.2",
    "@agentclientprotocol/codex-acp": "^1.1.7",
    "@biomejs/biome": "^2.5.5",
    "@sinclair/typebox": "^0.34.52",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/semver": "^7.7.1",
    "@types/sql.js": "^1.4.10",
    "acpx": "^0.13.0",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.62.0",
    "semver": "^7.8.5",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
