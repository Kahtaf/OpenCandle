{
  "name": "opencandle",
  "version": "0.10.0",
  "description": "Financial trading & investing agent",
  "license": "MIT",
  "homepage": "https://opencandle.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kahtaf/OpenCandle.git"
  },
  "bugs": {
    "url": "https://github.com/Kahtaf/OpenCandle/issues"
  },
  "type": "module",
  "workspaces": [
    "gui/server",
    "gui/web"
  ],
  "bin": {
    "opencandle": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tool-kit": {
      "types": "./dist/tool-kit.d.ts",
      "import": "./dist/tool-kit.js"
    },
    "./infra": {
      "types": "./dist/infra/index.d.ts",
      "import": "./dist/infra/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    },
    "./workflows": {
      "types": "./dist/workflows/index.d.ts",
      "import": "./dist/workflows/index.js"
    }
  },
  "pi": {
    "extensions": [
      "./dist/pi/opencandle-extension.js"
    ]
  },
  "keywords": [
    "opencandle",
    "finance",
    "stock",
    "investing",
    "trading",
    "options",
    "market-data",
    "portfolio",
    "ai-agent",
    "terminal",
    "financial-analysis",
    "sentiment",
    "technical-analysis",
    "pi-package"
  ],
  "files": [
    "assets/logo.svg",
    "dist",
    "gui/server",
    "gui/shared",
    "gui/web/dist",
    "src"
  ],
  "scripts": {
    "check:node": "node scripts/check-node-version.mjs",
    "prebuild": "npm run check:node && node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc && chmod +x dist/cli.js",
    "prepare": "npm run build && npm run gui:web:build",
    "prestart": "npm run check:node",
    "start": "tsx src/cli.ts",
    "gui:web:build": "npm --workspace @opencandle/gui-web run build",
    "docs:site:build": "node website/build.mjs",
    "docs:site:serve": "node website/serve.mjs",
    "docs:links:check": "node scripts/check-public-doc-links.mjs",
    "gui": "tsx gui/server/server.ts",
    "gui:dev": "tsx gui/server/server.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "pretest": "npm run check:node",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx tests/e2e/tools.test.ts",
    "test:e2e:cli": "tsx tests/e2e/cli.test.ts",
    "test:e2e:credential-prompt": "tsx tests/e2e/credential-prompt.test.ts",
    "test:e2e:credential-snooze": "tsx tests/e2e/credential-snooze.test.ts",
    "test:e2e:credential-soft-fallback": "tsx tests/e2e/credential-soft-fallback.test.ts",
    "test:e2e:credential-per-workflow-cap": "tsx tests/e2e/credential-per-workflow-cap.test.ts",
    "test:gui:browser": "OPENCANDLE_GUI_BROWSER=1 vitest run --config vitest.config.gui.ts",
    "test:e2e:providers": "tsx tests/e2e/providers.test.ts",
    "test:evals": "vitest run --config vitest.config.evals.ts",
    "eval:router-live": "tsx tests/scripts/run-live-router-eval.ts",
    "test:evals:usually": "EVAL_TIER=usually vitest run --config vitest.config.evals.ts",
    "test:evals:product": "tsx tests/scripts/run-product-evals.ts",
    "test:evals:competitive": "tsx tests/scripts/run-competitive-finance-eval.ts",
    "test:packed-install": "node scripts/packed-install-smoke.mjs",
    "eval:competitive:analyze": "tsx tests/scripts/analyze-competitive-finance-report.ts",
    "review:pr": ".agents/skills/autoreview/scripts/autoreview --mode branch --prompt-file .agents/skills/autoreview/references/opencandle-review.md --parallel-tests \"npx tsc --noEmit && npx vitest run\"",
    "package:contents:check": "node scripts/check-package-contents.mjs",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "version:set": "npm version",
    "prepublishOnly": "npm run release:check",
    "publish:dry": "npm run release:check && npm publish --access public --dry-run",
    "release:check": "npx tsc --noEmit && npx biome ci . && npm test && npm run docs:site:build && npm run package:contents:check && npm run test:packed-install && npm run docs:links:check",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "engines": {
    "node": ">=22.19.0 <27"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.80.2",
    "@earendil-works/pi-ai": "^0.80.2",
    "@earendil-works/pi-coding-agent": "^0.80.2",
    "better-sqlite3": "^12.11.1",
    "duck-duck-scrape": "^2.2.7",
    "tsx": "^4.22.4",
    "yahoo-finance2": "^3.15.3"
  },
  "peerDependencies": {
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.52.0",
    "@agentclientprotocol/codex-acp": "^1.0.1",
    "@biomejs/biome": "^2.5.1",
    "@sinclair/typebox": "^0.34.49",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.0.1",
    "acpx": "^0.11.2",
    "playwright-core": "^1.61.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9",
    "vitest-evals": "^0.14.0"
  }
}
